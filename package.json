{
  "name": "gpt4-langchain-pdf-chatbot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Mayooear<twitter:@mayowaoshin>",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint --ignore-path .gitignore \"**/*.+(ts|js|tsx)\"",
    "format": "prettier --ignore-path .gitignore \"**/*.+(ts|js|tsx)\" --write",
    "ingest": "tsx -r dotenv/config scripts/ingest-data.ts dotenv_config_path=.env.local",
    "doctor": "tsx -r dotenv/config scripts/doctor.ts dotenv_config_path=.env.local",
    "probe": "tsx -r dotenv/config scripts/probe-dim.ts dotenv_config_path=.env.local",
    "pdf-doctor": "tsx scripts/pdf-doctor.ts",
    "ocr": "tsx -r dotenv/config scripts/ocr-scanned.ts dotenv_config_path=.env.local",
    "test": "vitest",
    "test:run": "vitest run",
    "probe-batch": "tsx -r dotenv/config scripts/probe-batch.ts dotenv_config_path=.env.local"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^0.3.15",
    "@langchain/google-genai": "^0.2.13",
    "@langchain/openai": "^0.3.15",
    "@langchain/pinecone": "^0.1.3",
    "@langchain/textsplitters": "^0.1.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@pinecone-database/pinecone": "^3.0.3",
    "@radix-ui/react-accordion": "^1.2.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "langchain": "^0.3.29",
    "lucide-react": "^0.460.0",
    "next": "^14.2.15",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "starter",
    "gpt4",
    "pinecone",
    "typescript",
    "nextjs",
    "langchain",
    "law",
    "legal",
    "pdf",
    "openai"
  ]
}
